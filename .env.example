# Used by docker compose. For a native install, use node --env-file=.env --import tsx server/index.ts.
# Choose a unique password of at least 12 characters. Do not commit .env.
APP_PASSWORD=
# Exact browser origin, without a trailing slash. Configure your HTTPS reverse proxy to match.
PUBLIC_ORIGIN=https://margin.example.com
COOKIE_SECURE=true
# Native installs default to localhost. Behind a local reverse proxy, keep this address.
HOST=127.0.0.1
PORT=4317
NODE_ENV=production
# Optional initial model. A model saved in Margin overrides this value.
# Omit to use the server account's configured/default model before a selection is saved.
# CODEX_MODEL=
