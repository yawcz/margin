# Copy to .env. Do not commit .env.
# Docker compose passes only APP_PASSWORD, PUBLIC_ORIGIN, CODEX_MODEL and TUTOR_TIMEOUT_MS to the
# container. Native installs load every key with: node --env-file=.env --import tsx server/index.ts

# Choose a unique password of at least 12 characters.
APP_PASSWORD=
# Exact browser origin, without a trailing slash. Configure your HTTPS reverse proxy to match.
PUBLIC_ORIGIN=https://margin.example.com
# Optional initial model. A model saved in Margin overrides this value.
# Omit to use the server account's configured/default model before a selection is saved.
# CODEX_MODEL=
# Optional. How long one tutor reply may take before it is interrupted, in milliseconds.
# TUTOR_TIMEOUT_MS=600000

# Native installs only; the container image sets these itself.
COOKIE_SECURE=true
# Native installs default to localhost. Behind a local reverse proxy, keep this address.
HOST=127.0.0.1
PORT=4317
NODE_ENV=production
